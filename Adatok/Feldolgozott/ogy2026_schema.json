{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deakjahn/Valasztas-2026/ogy2026_schema.json",
  "type": "object",
  "properties": {
    "ev": { "const": 2026 },
    "idopont": {
      "type": "string",
      "format": "date-time",
      "description": "fájl létrehozásának időpontja"
    },
    "nevjegyzek": {
      "type": "integer",
      "description": "A lakcímük szerinti szavazóköri névjegyzékben lévő választópolgárok"
    },
    "atjelent": {
      "type": "integer",
      "description": "Belföldi szavazókörökbe átjelentkezett választópolgárok"
    },
    "kulkepv": {
      "type": "integer",
      "description": "A külképviseleti névjegyzékben szereplő választópolgárok"
    },
    "level": {
      "type": "integer",
      "description": "A levélben szavazók névjegyzékében szereplő választópolgárok"
    },
    "valaszto": {
      "type": "integer",
      "description": "Választópolgárok száma = nevjegyzek + atjelent + kulkepv + level"
    },
    "szavazo": { "type": "array" },
    "nemszavazo": { "type": "array" },
    "boritek": {
      "type": "integer",
      "description": "Urnában és beérkezett borítékokban lévő szavazólapok = ervenyes + ervenytelen"
    },
    "ervenyes": {
      "type": "array",
      "description": "Érvényes szavazólapok"
    },
    "ervenytelen": {
      "type": "array",
      "description": "Érvénytelen szavazólapok"
    },
    "part_ervenyes": {
      "type": "array",
      "description": "Pártlistákra leadott érvényes szavazatok száma összesen"
    },
    "partok": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "#/$defs/part" }
      },
      "additionalProperties": false
    },
    "nemz_ervenyes": {
      "type": "array",
      "description": "Nemzetiségi listákra leadott érvényes szavazatok száma összesen"
    },
    "nemzetisegek": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "#/$defs/nemzetiseg" }
      },
      "additionalProperties": false
    },
    "megyek": {
      "type": "object",
      "patternProperties": {
        "^[0-2][0-9]$": { "$ref": "#/$defs/megye" }
      },
      "additionalProperties": false
    },
    "levelszav": { "$ref": "#/$defs/level" }
  },
  "$defs": {
    "part": {
      "type": "object",
      "properties": {
        "azon": { "type": "integer" },
        "rovid": { "type": "string" },
        "nev": { "type": "string" },
        "jelolt": {
          "type": "integer",
          "description": "Jelöltek száma"
        },
        "mandatum": {
          "type": "integer",
          "description": "Elnyert mandátumok száma"
        },
        "szavazat": { "type": "array" },
        "hazai": { "type": "array" },
        "level": { "type": "array" }
      }
    },
    "nemzetiseg": {
      "type": "object",
      "properties": {
        "azon": { "type": "integer" },
        "rovid": { "type": "string" },
        "nev": { "type": "string" },
        "jelolt": {
          "type": "integer",
          "description": "Jelöltek száma"
        },
        "mandatum": {
          "type": "integer",
          "description": "Elnyert mandátumok száma"
        },
        "ervenyes": { "type": "integer" },
        "szavazo": { "type": "integer" }
      }
    },
    "jelolt": {
      "type": "object",
      "properties": {
        "azon": { "type": "integer" },
        "nev": { "type": "string" },
        "nev2": {
          "type": "string",
          "description": "nagy kezdőbetűk visszaállítva"
        },
        "maz": {
          "type": "string",
          "description": "megyeazonosító"
        },
        "oevk": {
          "type": "string",
          "description": "OEVK-azonosító"
        },
        "part": { "type": "string" },
        "szavazat": { "type": "array" },
        "mandatum": { "type": "boolean" }
      }
    },
    "megye": {
      "type": "object",
      "properties": {
        "maz": {
          "type": "string",
          "description": "megyeazonosító"
        },
        "nev": { "type": "string" },
        "kozeppont": {
          "type": "string",
          "description": "megye földrajzi középpontja"
        },
        "korvonal": {
          "type": "string",
          "description": "megye körvonalát leíró térképi poligon"
        },
        "nevjegyzek": {
          "type": "integer",
          "description": "A lakcímük szerinti szavazóköri névjegyzékben lévő választópolgárok"
        },
        "atjelent": {
          "type": "integer",
          "description": "Belföldi szavazókörökbe átjelentkezett választópolgárok"
        },
        "atjelent_mashova": {
          "type": "integer",
          "description": "Belföldön máshova átjelentkezettek száma"
        },
        "kulkepv": {
          "type": "integer",
          "description": "A külképviseleti névjegyzékben szereplő választópolgárok"
        },
        "valaszto": {
          "type": "integer",
          "description": "Választópolgárok száma = nevjegyzek + atjelent + kulkepv"
        },
        "szavazo": { "type": "array" },
        "nemszavazo": { "type": "array" },
        "boritek": {
          "type": "integer",
          "description": "Urnában és beérkezett borítékokban lévő szavazólapok = ervenyes + ervenytelen"
        },
        "ervenyes": {
          "type": "array",
          "description": "Érvényes szavazólapok"
        },
        "ervenytelen": {
          "type": "array",
          "description": "Érvénytelen szavazólapok"
        },
        "part_ervenyes": {
          "type": "array",
          "description": "Pártlistákra leadott érvényes szavazatok száma összesen"
        },
        "partok": { "$ref": "#/$defs/szamok" },
        "nemz_ervenyes": {
          "type": "array",
          "description": "Nemzetiségi listákra leadott érvényes szavazatok száma összesen"
        },
        "nemzetisegek": { "$ref": "#/$defs/szamok" },
        "oevkk": {
          "type": "object",
          "patternProperties": {
            "^[0-9][0-9]$": { "$ref": "#/$defs/oevk" }
          },
          "additionalProperties": false
        }
      }
    },
    "level": {
      "type": "object",
      "properties": {
        "beerkezett": {
          "type": "array",
          "description": "Beérkezett levélszavazási iratok"
        },
        "beerkezett_ervenyes": {
          "type": "array",
          "description": "Feldolgozott, érvényes"
        },
        "beerkezett_ervenytelen": {
          "type": "array",
          "description": "Feldolgozott, érvénytelen"
        },
        "boritek": {
          "type": "integer",
          "description": "Az érvényes szavazási iratokban lévő szavazólapok"
        },
        "elteres": {
          "type": "integer",
          "description": "többlet:+/hiány:-"
        },
        "ervenyes": {
          "type": "array",
          "description": "Érvényes szavazólapok"
        },
        "ervenytelen": {
          "type": "array",
          "description": "Érvénytelen szavazólapok"
        },
        "listas": { "$ref": "#/$defs/szamok" }
      }
    },
    "oevk": {
      "type": "object",
      "properties": {
        "oevk": {
          "type": "string",
          "description": "OEVK-azonosító"
        },
        "nev": { "type": "string" },
        "kozeppont": {
          "type": "string",
          "description": "OEVK földrajzi középpontja"
        },
        "korvonal": {
          "type": "string",
          "description": "OEVK körvonalát leíró térképi poligon"
        },
        "nevjegyzek": {
          "type": "integer",
          "description": "Választókerületi névjegyzékben szereplő választópolgárok aktuális száma"
        },
        "atjelent": {
          "type": "integer",
          "description": "OEVK-ba átjelentkezett szavazók száma"
        },
        "atjelent_mashova": {
          "type": "integer",
          "description": "Belföldön más OEVK-ba átjelentkezettek száma"
        },
        "kulkepv": {
          "type": "integer",
          "description": "A külképviseleti névjegyzékben szereplő választópolgárok"
        },
        "valaszto": {
          "type": "integer",
          "description": "Választópolgárok száma = nevjegyzek + atjelent + kulkepv"
        },
        "szavazo": { "type": "array" },
        "nemszavazo": { "type": "array" },
        "boritek": {
          "type": "integer",
          "description": "Urnában és beérkezett borítékokban lévő szavazólapok = ervenyes + ervenytelen"
        },
        "ervenyes": {
          "type": "array",
          "description": "Érvényes szavazólapok"
        },
        "ervenytelen": {
          "type": "array",
          "description": "Érvénytelen szavazólapok"
        },
        "jeloltek": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": { "$ref": "#/$defs/jelolt" }
          },
          "additionalProperties": false
        },
        "szavazokorok": {
          "type": "object",
          "patternProperties": {
            "^[0-9][0-9]-[0-9][0-9][0-9]-[0-9][0-9][0-9]-[0-9]$": { "$ref": "#/$defs/szavazokor" }
          },
          "additionalProperties": false
        }
      }
    },
    "szavazokor": {
      "type": "object",
      "properties": {
        "azon": { "type": "string" },
        "maz": {
          "type": "string",
          "description": "megyeazonosító"
        },
        "taz": {
          "type": "string",
          "description": "településazonosító"
        },
        "szk": {
          "type": "string",
          "description": "szavazókör-azonosító"
        },
        "oevk": {
          "type": "string",
          "description": "OEVK-azonosító"
        },
        "irsz": { "type": ["string", "null"] },
        "telepules": { "type": "string" },
        "cim": { "type": "string" },
        "intezmeny": { "type": "string" },
        "leiras": { "type": "string" },
        "szamlalo_szk": {
          "type": "boolean",
          "description": "Számlálásra kijelölt szavazókör"
        },
        "pozicio": {
          "type": "string",
          "description": "szavazókör térképi pozíciója"
        },
        "korvonal": {
          "type": "string",
          "description": "szavazókörhöz tartozó utcák körvonalát leíró térképi poligon"
        },
        "atjelent": {
          "type": "integer",
          "description": "B = Belföldi szavazókörökbe átjelentkezett választópolgárok"
        },
        "kulkepv": {
          "type": "integer",
          "description": "C = A külképviseleti névjegyzékben szereplő választópolgárok"
        },
        "boritek": {
          "type": "integer",
          "description": "Urnában és beérkezett borítékokban lévő szavazólapok = ervenyes + ervenytelen"
        },
        "egyeni": { "$ref": "#/$defs/egyeni" },
        "listas": {
          "allOf": [
            { "$ref": "#/$defs/statisztika" },
            { "$ref": "#/$defs/statisztika_plusz" },
            {
              "type": "object",
              "properties": {
                "boritek": {
                  "type": "integer",
                  "description": "K = Urnában és beérkezett borítékokban lévő szavazólapok = ervenyes + ervenytelen"
                },
                "partok": { "$ref": "#/$defs/partlista" },
                "nemzetisegi": { "$ref": "#/$defs/nemzetisegi_lista" }
              }
            }
          ]
        }
      }
    },
    "egyeni": {
      "allOf": [
        { "$ref": "#/$defs/statisztika" },
        { "$ref": "#/$defs/statisztika_plusz" },
        {
          "type": "object",
          "properties": {
            "szav": { "$ref": "#/$defs/szamok" }
          }
        }
      ]
    },
    "partlista": {
      "allOf": [
        { "$ref": "#/$defs/statisztika" },
        {
          "type": "object",
          "properties": {
            "szav": { "$ref": "#/$defs/szamok" }
          }
        }
      ]
    },
    "nemzetisegi_lista": {
      "allOf": [
        { "$ref": "#/$defs/statisztika" },
        {
          "type": "object",
          "properties": {
            "szav": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": { "$ref": "#/$defs/statisztika" }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "szamok": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "type": "array" }
      },
      "additionalProperties": false
    },
    "statisztika": {
      "type": "object",
      "properties": {
        "nevjegyzek": {
          "type": "integer",
          "description": "A = Szavazóköri névjegyzékben lévő választópolgárok száma"
        },
        "megjelent": {
          "type": "integer",
          "description": "F = Szavazókörben szavazó választópolgárok száma"
        },
        "belyegzo": {
          "type": "integer",
          "description": "K = Urnában és a beérkezett lezárt borítékokban lévő, lebélyegzett szavazólapok száma"
        },
        "belyegzo_nelkul": {
          "type": "integer",
          "description": "O = Urnában és a beérkezett lezárt borítékokban lévő, bélyegzőlenyomat nélküli szavazólapok száma"
        },
        "elteres": {
          "type": "integer",
          "description": "L = Eltérés a szavazóként megjelentek számától (L=K-J; többlet:+/hiány:-)"
        },
        "ervenyes": {
          "type": "array",
          "description": "N = Érvényes szavazólapok száma"
        },
        "ervenytelen": {
          "type": "array",
          "description": "M = Érvénytelen lebélyegzett szavazólapok száma"
        }
      }
    },
    "statisztika_plusz": {
      "type": "object",
      "properties": {
        "valaszto": {
          "type": "integer",
          "description": "E = Választópolgárok száma = nevjegyzek + atjelent + kulkepv"
        },
        "szavazo": { "type": "array" },
        "nemszavazo": { "type": "array" }
      }
    }
  }
}
